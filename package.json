{
  "name": "photopea-desktop",
  "version": "1.1.0",
  "description": "Desktop wrapper for Photopea – open-source online image editor",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron .",
    "build:ts": "tsc",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:ts && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build:ts && electron ."
  },
  "build": {
    "appId": "com.photopea.desktop",
    "productName": "Photopea",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "!src/**/*.ts"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    }
  },
  "keywords": [
    "photopea",
    "image-editor",
    "electron",
    "desktop"
  ],
  "author": "Photopea Desktop Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  }
}
